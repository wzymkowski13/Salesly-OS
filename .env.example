NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
ALLOWED_EMAILS=you@example.com,partner@example.com

# Lead Factory -> private PF repo / GitHub Actions (server-side only)
# Fine-grained token scoped only to wzymkowski13/pf, with Actions: Read and write.
GITHUB_ACTIONS_TOKEN=

# Google Calendar - prepared for the next integration step
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback


# USOS integration - server-side only. End users never see these credentials.
USOS_UJD_CONSUMER_KEY=
USOS_UJD_CONSUMER_SECRET=
USOS_PCZ_CONSUMER_KEY=
USOS_PCZ_CONSUMER_SECRET=
# Optional. Normally leave unset so production origin is used automatically.
USOS_CALLBACK_URL=

# Protects Vercel Cron endpoint used for daily USOS sync.
CRON_SECRET=


# Salesly Call Center Panel -> Salesly OS summary (server-side only)
# Expected payload: {"leads_today":14,"efficiency_today":0.92,"generated_at":"2026-10-05T10:00:00Z"}
CALL_CENTER_SUMMARY_URL=
CALL_CENTER_SUMMARY_TOKEN=
